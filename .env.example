# Backend / ingestion environment. Copy to `.env` (git-ignored) and fill in real values.
# Never commit real keys. The frontend has its own file: frontend/.env.example.

# local | production (production disables /docs and the OpenAPI schema)
ENVIRONMENT=local

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Embeddings (OpenAI) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Database (Postgres + pgvector). Matches docker-compose.yml ---
DATABASE_URL=postgresql+psycopg://nutrition:nutrition@localhost:5432/nutrition

# --- Admin routes (/api/admin/*). Leave empty to disable them ---
ADMIN_TOKEN=

# --- CORS: comma-separated list of allowed frontend origins ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Retrieval tunables (starting values; tuned from the Phase 2 evaluation) ---
TOP_K=6
CANDIDATE_K=30
PER_DOC_QUOTA=3
MIN_SIMILARITY=0.30

# --- Conversation and safety ---
HISTORY_TURNS=6
SAFETY_WINDOW_TURNS=3
SAFETY_SIMILARITY_THRESHOLD=0.80

# --- Rate limiting (requests per minute, per session and per IP) ---
RATE_LIMIT_PER_MIN=20
